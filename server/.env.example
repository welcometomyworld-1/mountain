# =================================================================
# PrivateID Server Environment Configuration
# =================================================================

# Server Port & Environment
# Render automatically injects PORT. On local development defaults to 5000.
PORT=5000
NODE_ENV=production

# Allowed Frontend Origins (CORS)
# Set to your production Vercel frontend URL (e.g. https://mountain-car.vercel.app)
# Supports comma-separated origins (e.g. https://app.vercel.app,https://yourdomain.com)
CLIENT_URL=https://your-frontend-app.vercel.app

# Database Connection (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mountain_car_game?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mountain_car_game?retryWrites=true&w=majority

# JWT Authentication Secret & Token Expiration
# Generate a strong random key (e.g., 64-character hex string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=7d

# Cloud Storage Provider (Cloudinary) - Highly Recommended for Render
# Since Render's free/starter disk is ephemeral, Cloudinary ensures avatar and media uploads persist permanently.
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WebRTC STUN / TURN Configuration
# High-reliability Google and Cloudflare STUN servers are configured by default.
# Add TURN credentials for users behind strict symmetric NAT / carrier-grade firewalls (e.g. Metered.ca, Twilio, Coturn)
# Single or comma-separated TURN URLs supported
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
